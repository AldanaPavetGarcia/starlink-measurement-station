{
  "title": "Red Starlink",
  "uid": "red-starlink",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["starlink", "network"],
  "templating": {
    "list": [
      {
        "name": "node_id",
        "type": "query",
        "label": "Nodo",
        "datasource": { "type": "postgres", "uid": "starlink_health_db" },
        "query": "SELECT DISTINCT node_id FROM network_metrics ORDER BY node_id",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Latencia y jitter (ms)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "starlink_health_db" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "starlink_health_db" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time AS \"time\", latency_ms, jitter_ms FROM network_metrics WHERE $__timeFilter(time) AND node_id IN ($node_id) ORDER BY time"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Packet loss (%)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "postgres", "uid": "starlink_health_db" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "starlink_health_db" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time AS \"time\", packet_loss_pct FROM network_metrics WHERE $__timeFilter(time) AND node_id IN ($node_id) ORDER BY time"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Throughput (Mbps)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "postgres", "uid": "starlink_health_db" },
      "fieldConfig": { "defaults": { "unit": "Mbits", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "starlink_health_db" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time AS \"time\", throughput_down_bps / 1000000.0 AS throughput_down_mbps, throughput_up_bps / 1000000.0 AS throughput_up_mbps FROM network_metrics WHERE $__timeFilter(time) AND node_id IN ($node_id) ORDER BY time"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Satélites visibles y obstrucción",
      "description": "is_obstructed como serie 0/1 superpuesta a satellite_count, para correlacionar visualmente caídas de satélites con eventos de obstrucción (RF-33).",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "postgres", "uid": "starlink_health_db" },
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "starlink_health_db" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time AS \"time\", satellite_count, is_obstructed::int AS is_obstructed FROM network_metrics WHERE $__timeFilter(time) AND node_id IN ($node_id) ORDER BY time"
        }
      ]
    },
    {
      "id": 5,
      "type": "histogram",
      "title": "Distribución de latencia",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "postgres", "uid": "starlink_health_db" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "starlink_health_db" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time AS \"time\", latency_ms FROM network_metrics WHERE $__timeFilter(time) AND node_id IN ($node_id) ORDER BY time"
        }
      ]
    }
  ]
}
