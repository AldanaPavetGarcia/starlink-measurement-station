# Copiar a .env y ajustar por entorno (nunca versionar .env, ver .gitignore).
# ADR-12: la config de conexión vive acá para que la migración local -> nube
# (docs/CLAUDE.md §6) sea solo un cambio de estas variables, sin tocar código.

# Broker MQTT (ADR-09)
MQTT_HOST=localhost
MQTT_PORT=1883
# Vacías por defecto: el broker local es allow_anonymous true (ADR-04/ADR-14),
# no hace falta nada acá salvo que MQTT_HOST apunte a un broker con auth (ej.
# el bridge a la VM de cátedra, ADR-20 -- ahí sí completar las dos).
MQTT_USERNAME=
MQTT_PASSWORD=

# Mock Starlink (ADR-06/07/08)
STARLINK_NODE_ID=lit-cordoba-01
CHAOS_PROFILE=CALM
TIME_WARP_FACTOR=1

# Extractor real (semana 10, perfil "real" -- NUNCA junto con "mocks", ver
# docker-compose.yml). DISH_GRPC_ADDR es la IP interna de la antena, fija en
# Bypass Mode (no configurable). POLL_INTERVAL_S por defecto 60s, igual al
# mock, para no cambiar el comportamiento aguas abajo (ADR-01).
DISH_GRPC_ADDR=192.168.100.1:9200
POLL_INTERVAL_S=60

# DB starlink_health_db (ADR-10/ADR-11) -- consumer + starlink_db en docker-compose.yml
# Sin puerto expuesto al host a propósito (ADR-14): solo el consumer y Grafana,
# dentro de la red Docker, necesitan acceder. Usar `docker exec` para psql manual.
STARLINK_DB_NAME=starlink_health
STARLINK_DB_USER=starlink_app
STARLINK_DB_PASSWORD=starlink_dev_password

# DB station_config_db (ADR-10, semana 7) -- catálogo de nodos/sensores, sin
# TimescaleDB. Tampoco expuesta al host (ADR-14).
STATION_CONFIG_DB_NAME=station_config
STATION_CONFIG_DB_USER=station_config_app
STATION_CONFIG_DB_PASSWORD=station_config_dev_password

# Backend FastAPI (semana 9, docs/07_API_REST.md) -- publicado a la
# intranet del LIT (ADR-14, tabla de exposición de puertos: "⚠️ Expuesto a
# la intranet del LIT"), NO públicamente como Grafana. En producción, el
# filtrado de IP a nivel de firewall/router del LIT (ADR-14 "Medidas de
# Seguridad Adicionales") es responsabilidad de infraestructura, no de este
# docker-compose.yml -- ver README.md.
# BACKEND_API_KEY: generar con `python -c "import secrets; print(secrets.token_hex(32))"`,
# nunca dejar el valor de ejemplo en un despliegue real.
BACKEND_API_KEY=change_me_backend_api_key_dev_only
BACKEND_PORT=8000
# ENABLE_INGEST_ENDPOINT: solo "true" para testing/backfill (RF-29, ADR-08).
# Debe quedar en "false" en cualquier entorno que no sea de desarrollo.
ENABLE_INGEST_ENDPOINT=false

# Grafana (ADR-13/ADR-14) -- único servicio expuesto públicamente a propósito.
# Cambiar GRAFANA_ADMIN_PASSWORD antes de cualquier despliegue real.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_dev_password
GRAFANA_PORT=3000
